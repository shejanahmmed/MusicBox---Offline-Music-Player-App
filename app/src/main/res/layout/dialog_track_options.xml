<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:padding="24dp">

    <!-- Drag Handle -->
    <ImageView
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="24dp"
        android:background="@drawable/shape_drag_handle"
        app:tint="@color/colorIcon"
        android:src="@drawable/thumb_null" />

    <!-- "METADATA" Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="METADATA"
        android:textColor="@color/colorTextSecondary"
        android:textSize="12sp"
        android:letterSpacing="0.15"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <!-- Main Track Card -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_track_card_outlined"
        android:padding="16dp">

        <androidx.cardview.widget.CardView
            android:id="@+id/cv_art"
            android:layout_width="80dp"
            android:layout_height="80dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                android:id="@+id/iv_track_art"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@color/background_dark" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tv_track_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            tools:text="XTAL"
            android:textColor="@color/colorTextPrimary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:scrollHorizontally="true"
            android:fadingEdge="horizontal"
            app:layout_constraintStart_toEndOf="@id/cv_art"
            app:layout_constraintEnd_toStartOf="@+id/tv_file_size_badge"
            app:layout_constraintTop_toTopOf="@id/cv_art"
            app:layout_constraintBottom_toTopOf="@+id/tv_track_artist"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/tv_track_artist"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            tools:text="APHEX TWIN"
            android:textColor="@color/colorTextSecondary"
            android:textSize="12sp"
            android:letterSpacing="0.1"
            android:textAllCaps="true"
            android:singleLine="true"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:scrollHorizontally="true"
            android:fadingEdge="horizontal"
            app:layout_constraintStart_toEndOf="@id/cv_art"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_track_title"
            app:layout_constraintBottom_toTopOf="@+id/tv_track_path_sub" />

        <TextView
            android:id="@+id/tv_track_path_sub"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="2dp"
            tools:text="/storage/emulated/0/Music/song.mp3"
            android:textColor="@color/colorTextSecondary"
            android:textSize="9sp"
            android:fontFamily="monospace"
            android:singleLine="true"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:scrollHorizontally="true"
            android:fadingEdge="horizontal"
            app:layout_constraintStart_toEndOf="@id/cv_art"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_track_artist"
            app:layout_constraintBottom_toBottomOf="@id/cv_art" />

        <TextView
            android:id="@+id/tv_file_size_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="12.4 MB"
            android:textColor="@color/colorTextPrimary"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/bg_track_card_outlined"
            android:backgroundTint="@color/colorStroke"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Queue Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        android:baselineAligned="false">

        <!-- Play Next Button -->
        <LinearLayout
            android:id="@+id/btn_play_next_box"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_track_card_outlined"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="12dp"
            android:layout_marginEnd="8dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_queue_music"
                app:tint="@color/colorIconSecondary"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PLAY NEXT"
                android:textColor="@color/colorTextPrimary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Play Last Button -->
        <LinearLayout
            android:id="@+id/btn_play_last_box"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_track_card_outlined"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="12dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_playlist_add"
                app:tint="@color/colorIconSecondary"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PLAY LAST"
                android:textColor="@color/colorTextPrimary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Stats Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        android:baselineAligned="false">

        <!-- Format -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_track_card_outlined"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp"
            android:layout_marginEnd="8dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_music_note"
                app:tint="@color/colorIconSecondary"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tv_stat_format"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="FLAC"
                android:textColor="@color/colorTextPrimary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FORMAT"
                android:textColor="@color/colorTextSecondary"
                android:textSize="8sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Bitrate -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_track_card_outlined"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp"
            android:layout_marginEnd="8dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_equalizer"
                app:tint="@color/colorIconSecondary"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tv_stat_bitrate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="942 KBPS"
                android:textColor="@color/colorTextPrimary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BITRATE"
                android:textColor="@color/colorTextSecondary"
                android:textSize="8sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Duration -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_track_card_outlined"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_timer"
                app:tint="@color/colorIconSecondary"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tv_stat_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="03:45"
                android:textColor="@color/colorTextPrimary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DURATION"
                android:textColor="@color/colorTextSecondary"
                android:textSize="8sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Action Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_track_card_outlined"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="16dp"
        android:paddingVertical="12dp">

        <ImageButton
            android:id="@+id/btn_favorite"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_favorite_border"
            app:tint="@color/colorIcon" />

        <ImageButton
            android:id="@+id/btn_add_to_playlist"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_playlist_add"
            app:tint="@color/colorIcon" />

        <ImageButton
            android:id="@+id/btn_edit"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_edit"
            app:tint="@color/colorIcon" />

        <ImageButton
            android:id="@+id/btn_set_as"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_image"
            app:tint="@color/colorIcon" />

        <ImageButton
            android:id="@+id/btn_share"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_share"
            app:tint="@color/colorIcon" />

        <ImageButton
            android:id="@+id/btn_delete"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_delete"
            app:tint="@color/colorIcon" />
    </LinearLayout>

</LinearLayout>
