<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_home_card"
    android:foreground="@drawable/ripple_home_card"
    android:clipToOutline="true"
    android:clickable="true"
    android:focusable="true"
    android:padding="16dp">

    <!-- Icon Bubble Container -->
    <FrameLayout
        android:id="@+id/fl_icon_bubble"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/bg_home_icon_bubble"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_box_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_heart"
            app:tint="@color/primary_red" />
    </FrameLayout>

    <!-- Subtle Chevron on Top Right -->
    <ImageView
        android:id="@+id/iv_box_arrow"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_chevron_right"
        app:tint="@color/colorIconSecondary"
        android:alpha="0.3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/fl_icon_bubble"
        app:layout_constraintBottom_toBottomOf="@id/fl_icon_bubble" />

    <!-- Title (e.g. "Favorites", "Tracks", "Playlists") -->
    <TextView
        android:id="@+id/tv_box_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        tools:text="Favorites"
        android:textColor="@color/colorTextPrimary"
        android:textSize="16sp"
        android:textStyle="bold"
        android:letterSpacing="0.01"
        android:singleLine="true"
        android:ellipsize="marquee"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fl_icon_bubble"
        app:layout_constraintBottom_toTopOf="@+id/tv_box_count"
        app:layout_constraintVertical_bias="1.0" />

    <!-- Subtitle Count (e.g. "0 Favorites", "20 Tracks", "Tune Sound") -->
    <TextView
        android:id="@+id/tv_box_count"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        tools:text="0 Favorites"
        android:textColor="@color/colorTextSecondary"
        android:textSize="12sp"
        android:singleLine="true"
        android:ellipsize="marquee"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_box_label"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
