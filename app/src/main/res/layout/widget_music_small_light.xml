<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_small_light"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="12dp"
    android:paddingBottom="6dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Album Art / Tape Window Container -->
    <RelativeLayout
        android:id="@+id/widget_album_art_container"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="center_horizontal">

        <ImageView
            android:id="@+id/widget_album_art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_widget_placeholder" />

    </RelativeLayout>

    <!-- Track Meta (Title, Artist) -->
    <TextView
        android:id="@+id/widget_track_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sahiba"
        android:textSize="15sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-condensed"
        android:textColor="#1c1a16"
        android:singleLine="true"
        android:ellipsize="end"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:layout_gravity="center_horizontal" />

    <TextView
        android:id="@+id/widget_track_artist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ADITYA RIKHARI"
        android:textSize="9sp"
        android:textColor="#7a7464"
        android:fontFamily="monospace"
        android:singleLine="true"
        android:ellipsize="end"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:layout_gravity="center_horizontal" />

    <!-- Controls Row -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_gravity="center_horizontal"
        android:clipChildren="false"
        android:clipToPadding="false">

        <ImageButton
            android:id="@+id/widget_btn_prev"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="18dp"
            android:background="@android:color/transparent"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_prev"
            android:tint="#1c1a16"
            android:contentDescription="Previous" />

        <ImageButton
            android:id="@+id/widget_btn_play"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_widget_play_button_light"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_play"
            android:tint="#ece6d8"
            android:contentDescription="Play/Pause" />

        <ImageButton
            android:id="@+id/widget_btn_next"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="18dp"
            android:background="@android:color/transparent"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_next"
            android:tint="#1c1a16"
            android:contentDescription="Next" />

    </LinearLayout>

</LinearLayout>
