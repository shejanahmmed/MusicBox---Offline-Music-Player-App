<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Layer 1: Outer Soft Glow (15% Alpha Red) -->
    <item
        android:left="0dp"
        android:top="0dp"
        android:right="0dp"
        android:bottom="0dp">
        <shape android:shape="oval">
            <solid android:color="#26e8192c" />
        </shape>
    </item>

    <!-- Layer 2: Medium Glow (35% Alpha Red) -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="oval">
            <solid android:color="#59e8192c" />
        </shape>
    </item>

    <!-- Layer 3: Solid Red Border Line (100% Alpha Red) -->
    <item
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp">
        <shape android:shape="oval">
            <solid android:color="#e8192c" />
        </shape>
    </item>

    <!-- Layer 4: Inner Dark Background Fill -->
    <item
        android:left="5dp"
        android:top="5dp"
        android:right="5dp"
        android:bottom="5dp">
        <shape android:shape="oval">
            <solid android:color="#141414" />
        </shape>
    </item>
</layer-list>
